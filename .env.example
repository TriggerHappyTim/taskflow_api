# Скопируйте этот файл в .env и заполните значения.
# Файл .env должен быть в .gitignore — секретов в репозитории быть не должно.

# --- Приложение ---
DEBUG=false

# --- База данных ---
# SQLite локально:
DATABASE_URL=sqlite+aiosqlite:///./taskflow.db
# PostgreSQL в Docker:
# DATABASE_URL=postgresql+asyncpg://taskflow:taskflow@localhost:5432/taskflow

# --- JWT ---
# Сгенерируйте надёжный ключ, например: python -m secrets_token (или openssl rand -hex 32)
SECRET_KEY=change-me-to-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=60

# --- Telegram ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_URL=
# Прокси для обхода блокировки api.telegram.org из РФ (необязательно):
TELEGRAM_PROXY=

# --- MAX ---
# Токен бота выдаётся на платформе MAX для партнёров (dev.max.ru)
MAX_BOT_TOKEN=
MAX_API_URL=https://platform-api2.max.ru
# Секрет вебхука: сверяется с query-параметром secret во входящих запросах
MAX_WEBHOOK_SECRET=
